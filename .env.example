# Copy to .env and fill in. Never commit .env.
NUXT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/clautverse
# Long random string, e.g. `openssl rand -base64 32`
NUXT_BETTER_AUTH_SECRET=
NUXT_BETTER_AUTH_URL=http://localhost:3000
# Leave empty locally: emails are printed to the server console instead of sent.
NUXT_RESEND_API_KEY=
NUXT_EMAIL_FROM="Clautverse <no-reply@example.com>"
# Long random string used to sign pagination cursors
NUXT_CURSOR_SECRET=
